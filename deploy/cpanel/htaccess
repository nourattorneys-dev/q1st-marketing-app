# Articles AI dashboard (README, "Hosting on cPanel"): Passenger runs the Node app in ~/dashboard-app, a link to the
# current release in ~/dashboard-releases. Nothing in this web root is the app; its settings are in ~/dashboard-shared.
PassengerAppRoot "/home/fakhernco/dashboard-app"
PassengerBaseURI "/"
PassengerNodejs "/opt/alt/alt-nodejs22/root/usr/bin/node"
PassengerAppType node
PassengerStartupFile app.cjs
PassengerAppEnv production


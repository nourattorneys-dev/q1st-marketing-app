# /opt/q1st-app/app.env on the server (mode 600). Values with special characters go in single quotes.
APP_URL=https://app.q1st.io
APP_PORT=3200
ADMIN_EMAIL=
ENGINE_BASE_URL=http://127.0.0.1:8140/api/v1
ENGINE_API_KEY=
DB_MODE=postgres
DATABASE_URL=postgres://q1st_app:PASSWORD@127.0.0.1:5432/q1st_app
DB_POOL_MAX=5
WEBHOOK_ENCRYPTION_KEY=
EMAIL_MODE=graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
EMAIL_FROM=Q1st <notifications@quantum1st.com>
CRON_SECRET=
BACKUP_KEEP_DAYS=14

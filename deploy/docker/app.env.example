# /opt/q1st-app/app.env on the server (mode 600). Values with special characters go in single quotes.
APP_URL=https://app.q1st.io
# Each client at its own address, <name>.CLIENT_DOMAIN (the name is set in the staff portal); one sign-in for all of
# them. APP_URL must be one name under it. Empty: every client at APP_URL. Names no client may take: comma-separated
# (APP_URL's own name is always kept).
CLIENT_DOMAIN=q1st.io
CLIENT_RESERVED_NAMES=www,api,mail,smtp,staff,admin,portal,static,cdn,status,help,support
APP_PORT=3200
ADMIN_EMAIL=
ENGINE_BASE_URL=http://127.0.0.1:8140/api/v1
# Makes the first client and its site on first start (P1b); afterwards each site keeps its own key, encrypted.
ENGINE_API_KEY=
DB_MODE=postgres
DATABASE_URL=postgres://q1st_app:PASSWORD@127.0.0.1:5432/q1st_app
DB_POOL_MAX=5
WEBHOOK_ENCRYPTION_KEY=
# 32 random bytes, base64 (openssl rand -base64 32): encrypts each site's engine key. Unset: WEBHOOK_ENCRYPTION_KEY is used.
APP_ENCRYPTION_KEY=
EMAIL_MODE=graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
EMAIL_FROM=Q1st <notifications@quantum1st.com>
CRON_SECRET=
# P1c: the engine signs staff-portal requests with this; the same value is the engine's Q1ST_APP_SECRET (openssl rand -hex 32).
PROVISION_SECRET=
PROVISION_MAX_SKEW_SECONDS=300
# P2: a client's logo is fetched once and kept; the largest kept, and how long its address may take.
LOGO_MAX_KB=512
LOGO_TIMEOUT_SECONDS=10
BACKUP_KEEP_DAYS=14

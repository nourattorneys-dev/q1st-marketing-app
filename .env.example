# Content engine: "mock" uses built-in sample data (no key needed); "live" calls Quantum1st.
ENGINE_MODE=mock
# Required when ENGINE_MODE=live
ENGINE_BASE_URL=
ENGINE_API_KEY=

# Sign-in: "mock" = local test logins (development only, refused on Vercel); "clerk" = real sign-in.
# AUTH_MODE is read at build time and at runtime: rebuild after changing it.
AUTH_MODE=mock
# Test logins are also refused in production builds (next build / next start) unless this is 1.
# Only for local test builds — never set it on a server people can reach.
ALLOW_TEST_LOGINS=
# Required when AUTH_MODE=clerk (dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# "required" (default): Admins must turn on two-factor login, Reviewers are reminded (needs Clerk's Pro plan).
# "off": nothing asks for it, for Clerk's free plan, which has no two-factor login.
TWO_FACTOR=

# Dashboard storage (design §4): "memory" keeps it in this server's memory (local development and tests; refused in
# production); "mysql" = the client's MySQL 8. The app creates its tables on first use (locally also: pnpm db:migrate).
DB_MODE=memory
# mysql://user:password@host:3306/database (URL-encode special characters in the password)
DATABASE_URL=
# 32 random bytes, base64 (openssl rand -base64 32): encrypts the webhook secret. Required with DB_MODE=mysql.
WEBHOOK_ENCRYPTION_KEY=

# Notification emails (design §10, M5b): "log" sends nothing (local); "smtp" sends through the client's own mail server.
EMAIL_MODE=log
# The mail server. On a cPanel host: localhost and 587 (on this machine no TLS is used; any other host must offer TLS).
SMTP_HOST=
SMTP_PORT=
# The mailbox's login. Put the password in single quotes ('…'): in this file an unquoted # starts a comment.
SMTP_USER=
SMTP_PASSWORD=
# The mailbox's own address, for example: Articles AI <notifications@dashboard.fakhernco.com>
EMAIL_FROM=
# The cron job sends it as "Authorization: Bearer …" to /api/cron/notifications, every 15 minutes (README).
CRON_SECRET=
# An audience's emails wait until nothing new has arrived for this many seconds, so a batch goes out as one email (default 120).
NOTIFY_QUIET_SECONDS=

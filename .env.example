# Content engine: "mock" uses built-in sample data (no key needed); "live" calls Quantum1st.
ENGINE_MODE=mock
# Required when ENGINE_MODE=live
ENGINE_BASE_URL=
ENGINE_API_KEY=

# Sign-in: "mock" = local test logins (development only, refused on Vercel); "clerk" = real sign-in.
# AUTH_MODE is read at build time and at runtime: rebuild after changing it.
AUTH_MODE=mock
# Test logins are also refused in production builds (next build / next start) unless this is 1.
# Only for local test builds — never set it on a server people can reach.
ALLOW_TEST_LOGINS=
# Required when AUTH_MODE=clerk (dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Dashboard storage (design §4): "memory" keeps it in this server's memory (local only, refused on Vercel);
# "neon" = Neon Postgres (Vercel Marketplace adds DATABASE_URL). Apply migrations with: pnpm db:migrate
DB_MODE=memory
DATABASE_URL=
# 32 random bytes, base64 (openssl rand -base64 32): encrypts the webhook secret. Required with DB_MODE=neon.
WEBHOOK_ENCRYPTION_KEY=

# Notification emails (design §10): "log" sends nothing (local); "resend" sends through Resend.
EMAIL_MODE=log
RESEND_API_KEY=
# For example: Articles AI <notifications@fakhernco.com> (the domain needs Resend's DNS records in Cloudflare)
EMAIL_FROM=
# Vercel Cron sends it as "Authorization: Bearer …" to /api/cron/notifications (vercel.json, every 15 minutes).
CRON_SECRET=
# An audience's emails wait until nothing new has arrived for this many seconds, so a batch goes out as one email (default 120).
NOTIFY_QUIET_SECONDS=
